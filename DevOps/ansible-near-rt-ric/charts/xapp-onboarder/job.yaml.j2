apiVersion: v1
kind: ConfigMap
metadata:
  name: xapp-descriptors
  namespace: ricxapp
data:
  schema.json: |
    {{ XAPP_SCHEMA | indent(4) }}
  config-file.json: |
    {{ XAPP_CONFIG | indent(4) }}
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: xapp-onboarder
  namespace: ricxapp
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: xapp-onboarder-admin
  namespace: ricxapp
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: admin
subjects:
  - kind: ServiceAccount
    name: xapp-onboarder
    namespace: ricxapp
---
apiVersion: batch/v1
kind: Job
metadata:
  name: xapp-onboarder
  namespace: ricxapp
spec:
  template:
    spec:
      serviceAccountName: xapp-onboarder
      containers:
      - name: xapp-onboarder
        # I will add an internal registry for k8s
        # the tag is set from latest commit hash from the o-ran-sc/ric-plt-appmgr repo
        image: farbodbij/xapp-appmgr:0545415b5
        command: ["/bin/sh", "-c"]
        args:
          - |
            set -e
            # dms_cli downloads the helm client to /tmp/xapp_onboarder; make it visible
            # to `dms_cli install`, which invokes `helm` from PATH
            export PATH="/tmp/xapp_onboarder:${PATH}"
            if [ ! -f /xapp/config-file.json ] || [ ! -f /xapp/schema.json ]; then
              echo "xapp config and/or schema not found!" >&2
              exit 1
            fi

            dms_cli onboard /xapp/config-file.json /xapp/schema.json
            dms_cli get_charts_list

            # `dms_cli install` runs `helm install`, which fails if the release
            # already exists, so remove a previous release first
            if helm status "${XAPP_NAME}" -n ricxapp >/dev/null 2>&1; then
              dms_cli uninstall "${XAPP_NAME}" ricxapp
            fi

            dms_cli install "${XAPP_NAME}" "${XAPP_VERSION}" ricxapp

        env:
        - name: XAPP_NAME
          value: "{{ XAPP_NAME }}"
        - name: XAPP_VERSION
          value: "{{ XAPP_VERSION }}"
        - name: CHART_REPO_URL
          value: "{{ CHART_REPO_URL }}"
        # dms_cli's default is helm 2.12.3, which needs `helm init`; use helm 3 instead
        - name: HELM_VERSION
          value: "3.14.4"

        volumeMounts:
          - name: xapp-descriptors
            mountPath: /xapp
            readOnly: true

      volumes:
        - name: xapp-descriptors
          configMap:
            name: xapp-descriptors

      restartPolicy: Never
  backoffLimit: 4
